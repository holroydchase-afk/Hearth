# Edge function secrets. Set on the hosted project with:
#   supabase secrets set --env-file supabase/functions/.env --project-ref jqvgjfbhzbvfdhtnvgzr
# Copy to supabase/functions/.env (git-ignored). Never commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically: do NOT put them here.

# sign-media (Backblaze B2, US East)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
MEDIA_KEK=            # 32 random bytes, base64: openssl rand -base64 32
ALLOWED_ORIGINS=

# notify
RESEND_API_KEY=
RESEND_FROM=hello@hearth.family   # address only; the sender name is added per email ("Chase on Hearth")
APP_LINK_BASE=https://hearth.family
EXPO_ACCESS_TOKEN=    # only if "enhanced push security" is on in Expo
NOTIFY_CRON_SECRET=   # optional: lets the cron call notify without the service role key
